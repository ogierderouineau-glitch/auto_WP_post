# Optional local global configuration.
# Client credentials belong in the ignored clients.json file.
APP_NAME=Speech2Post

# Providers
OPENAI_API_KEY=
V2_LANGUAGE_MODEL=gpt-5.6
V2_VISION_MODEL=gpt-5-mini
V2_TRANSCRIPTION_MODEL=gpt-4o-transcribe
V2_METADATA_MODEL=gpt-5-mini
V2_REVISION_MODEL=gpt-5-mini

# Local limits
V2_SESSION_ROOT=data/v2_sessions
V2_MAX_IMAGE_BYTES=20971520
V2_MAX_AUDIO_BYTES=26214400

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GCS_DATA_BUCKET=
GCS_KNOWLEDGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
